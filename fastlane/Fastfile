default_platform(:ios)

# 환경 변수 (~/.zshrc):
# - ASC_KEY_ID            App Store Connect API Key ID
# - ASC_ISSUER_ID         App Store Connect API Issuer ID
# - ASC_KEY_FILEPATH      .p8 파일 경로 (default: fastlane/keys/AuthKey_<ID>.p8)
#
# 프로젝트 값:
#   BUNDLE_ID   dev.kyungmin.Ccutu
#   SCHEME      Ccutu
#   PROJECT     Ccutu.xcodeproj (xcodegen이 project.yml에서 생성, git에 없음)
#   6.3" 시뮬   iPhone 17 Pro      615217CA-3DD3-413A-922B-B1325055A6FA
#   6.9" 시뮬   iPhone 17 Pro Max  FC8F7508-82FC-494B-9396-DBFE26F91BA9
#   UI 테스트   CcutuSnapshots (스크린샷 lane용, 아직 없음 — App Store 제출 때 만든다)
#   LOCALE      ko

BUNDLE_ID = "dev.kyungmin.Ccutu"
SCHEME = "Ccutu"
PROJECT = "Ccutu.xcodeproj"
LOCALE = "ko"
UI_TEST_TARGET = "CcutuSnapshots"
UDIDS = {
  "iPhone 17 Pro"     => "615217CA-3DD3-413A-922B-B1325055A6FA",
  "iPhone 17 Pro Max" => "FC8F7508-82FC-494B-9396-DBFE26F91BA9",
}

TEAM_ID = "4MKG9D7KY5"
ENTITLEMENTS = File.expand_path("../Ccutu/Ccutu.entitlements", __dir__)

# 앱 ID에 Game Center 기능이 없으면 켠다(엔타이틀먼트에 game-center가 있을 때만 부른다).
def ensure_game_center(api_key)
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
  UI.user_error!("App ID #{BUNDLE_ID}를 찾지 못함") unless bundle
  gc = Spaceship::ConnectAPI::BundleIdCapability::Type::GAME_CENTER
  caps = bundle.get_capabilities.map(&:capability_type)
  UI.message "App ID 기능: #{caps.join(', ')}"
  return false if caps.include?(gc)
  bundle.create_capability(gc)
  UI.success "App ID에 Game Center 기능을 켬"
  true
end

def profile_has_entitlement?(path, key)
  require 'open3'
  out, status = Open3.capture2("security", "cms", "-D", "-i", path)
  status.success? && out.include?(key)
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: asc_key_abs_path   # gym이 xcodebuild에 넘기므로 절대 경로여야 한다
  )
end

# lane 실행 중 cwd는 fastlane/ 이므로 __dir__ 기준으로 절대 경로를 만든다
def asc_key_abs_path
  File.expand_path(ENV["ASC_KEY_FILEPATH"] || "keys/AuthKey_#{ENV['ASC_KEY_ID']}.p8")
end

before_all do
  # project.yml이 원본이므로 항상 재생성
  sh("which xcodegen > /dev/null 2>&1 && (cd .. && xcodegen generate) || echo '[fastlane] xcodegen not installed, skipping regen'")
end

platform :ios do
  desc "ASC API Key 인증만 검증 (실제 빌드 안 함, ASC 호출 1번)"
  lane :verify_auth do
    api_key = asc_api_key
    begin
      build_num = latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID)
      UI.success "✅ ASC 인증 OK — TestFlight 최신 빌드: #{build_num}"
    rescue => e
      UI.error "❌ ASC 인증 실패: #{e.message}"
      raise
    end
  end

  desc "ASC에 앱 레코드 생성 (처음 한 번). APP_NAME 환경변수로 이름 지정"
  lane :create_app do
    create_app_online(
      api_key: asc_api_key,
      app_identifier: BUNDLE_ID,
      app_name: ENV["APP_NAME"] || "끄투",
      sku: "ccutu-ios",
      language: "ko",
      platforms: ["ios"]
    )
  end

  desc "ASC 앱 이름(언어별 앱 정보의 name) 바꾸기. APP_NAME 없이 돌리면 현재 상태만 출력"
  lane :rename_app do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("App not found") unless app
    info = app.fetch_edit_app_info
    UI.user_error!("고칠 수 있는 앱 정보가 없음(심사 중이거나 출시된 상태)") unless info
    UI.message "app info state: #{info.state rescue info.app_store_state}"
    locs = info.get_app_info_localizations
    locs.each { |l| UI.message "  #{l.locale}: #{l.name}" }
    name = ENV["APP_NAME"]
    next unless name
    locs.each do |l|
      l.update(attributes: { name: name })
      UI.success "#{l.locale}: #{l.name} -> #{name}"
    end
  end

  desc "외부 테스트 준비 상태 출력(읽기만): 베타 그룹, 테스트 정보, 심사 연락처, 최근 빌드 심사 상태"
  lane :beta_status do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    app.get_beta_groups.each do |g|
      UI.message "group: #{g.name} internal=#{g.is_internal_group} public_link_enabled=#{g.public_link_enabled ? true : false}"
      # 공개 링크는 누구나 참여할 수 있는 주소라, SHOW_LINK=1 로 명시했을 때만 찍는다
      UI.message "  public link: #{g.public_link}" if ENV["SHOW_LINK"] == "1" && g.public_link_enabled
    end
    app.get_beta_app_localizations.each do |l|
      UI.message "beta info #{l.locale}: desc_set=#{!l.description.to_s.empty?} feedback_set=#{!l.feedback_email.to_s.empty?} privacy_set=#{!l.privacy_policy_url.to_s.empty?}"
    end
    d = Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }).first
    if d
      # 연락처는 개인 정보라 값 대신 채워졌는지만 찍는다(로그·CI에 남지 않게)
      UI.message "review contact: name_set=#{!d.contact_first_name.to_s.empty? && !d.contact_last_name.to_s.empty?} email_set=#{!d.contact_email.to_s.empty?} phone_set=#{!d.contact_phone.to_s.empty?} demo_required=#{d.demo_account_required.inspect}"
    else
      UI.message "review contact: none"
    end
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 3).each do |b|
      ext = b.build_beta_detail rescue nil
      UI.message "build #{b.version} processing=#{b.processing_state} external=#{ext&.external_build_state} internal=#{ext&.internal_build_state}"
    end
  end

  desc "외부 테스트 제출: 테스트 정보·심사 연락처·빌드 안내를 채우고, 외부 그룹에 넣고, 베타 심사에 낸다"
  desc "REVIEW_INFO_DIR = first_name/last_name/email_address/phone_number.txt 가 있는 폴더(저장소 밖). BUILD_NUMBER 필수"
  desc "BETA_GROUP = 외부 그룹 이름(외부 그룹이 하나뿐이면 생략 가능). FEEDBACK_EMAIL = 테스터에게 보일 피드백 주소(없으면 연락처 이메일)"
  desc "ENABLE_PUBLIC_LINK=1 일 때만 공개 링크를 켠다"
  lane :submit_external do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    dir = ENV["REVIEW_INFO_DIR"] or UI.user_error!("REVIEW_INFO_DIR 필요")
    read = ->(n) { File.read(File.join(dir, "#{n}.txt")).strip }
    contact = { contactFirstName: read.("first_name"), contactLastName: read.("last_name"),
                contactEmail: read.("email_address"), contactPhone: read.("phone_number") }
    here = File.expand_path("testflight", __dir__)
    desc_text = File.read(File.join(here, "ko/description.txt")).strip
    test_text = File.read(File.join(here, "ko/what_to_test.txt")).strip
    notes = File.read(File.join(here, "review_notes.txt")).strip

    # 1) 테스트 정보(앱 설명·피드백 이메일)
    loc = app.get_beta_app_localizations.find { |l| l.locale == "ko" }
    # 피드백 주소는 테스터에게 보인다. 따로 주지 않으면 연락처 이메일을 쓰고 그렇다고 알린다.
    feedback = ENV["FEEDBACK_EMAIL"].to_s.strip
    if feedback.empty?
      feedback = contact[:contactEmail]
      UI.important "FEEDBACK_EMAIL이 없어 심사 연락처 이메일을 테스터용 피드백 주소로 씀"
    end
    attrs = { description: desc_text, feedbackEmail: feedback }
    if loc
      Spaceship::ConnectAPI.patch_beta_app_localizations(localization_id: loc.id, attributes: attrs)
    else
      Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: attrs.merge(locale: "ko"))
    end
    UI.success "테스트 정보(ko) 저장"

    # 2) 베타 심사 연락처(값은 로그에 찍지 않는다)
    Spaceship::ConnectAPI.patch_beta_app_review_detail(app_id: app.id,
      attributes: contact.merge(demoAccountRequired: false, notes: notes))
    UI.success "심사 연락처 저장"

    # 3) 빌드의 '테스트할 내용'
    number = ENV["BUILD_NUMBER"].to_s.strip
    UI.user_error!("BUILD_NUMBER 필요(어느 빌드를 외부에 낼지 명시)") if number.empty?
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 50)
    build = builds.find { |b| b.version == number }
    UI.user_error!("빌드 #{number}를 찾지 못함") unless build
    bloc = build.get_beta_build_localizations.find { |l| l.locale == "ko" }
    if bloc
      Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: bloc.id, attributes: { whatsNew: test_text })
    else
      Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: { locale: "ko", whatsNew: test_text })
    end
    UI.success "빌드 #{build.version} 테스트 안내 저장"

    # 4) 외부 그룹 고르기: 이름을 주거나, 외부 그룹이 정확히 하나일 때만 그것
    externals = app.get_beta_groups.reject(&:is_internal_group)
    want = ENV["BETA_GROUP"].to_s.strip
    group = want.empty? ? (externals.size == 1 ? externals.first : nil) : externals.find { |g| g.name == want }
    UI.user_error!("외부 그룹을 정할 수 없음: BETA_GROUP으로 이름을 주세요 (#{externals.map(&:name).join(', ')})") unless group

    # 5) 베타 심사 먼저 제출. 실패하면 외부 그룹에 넣지 않고 멈춘다.
    begin
      build.post_beta_app_review_submission
    rescue => e
      UI.user_error!("베타 심사 제출 실패, 외부 배포 중단: #{e.message}")
    end
    UI.success "빌드 #{build.version} 베타 심사 제출"

    # 6) 심사 제출이 된 뒤에만 외부 그룹에 넣는다
    Spaceship::ConnectAPI.add_beta_groups_to_build(build_id: build.id, beta_group_ids: [group.id])
    UI.success "빌드 #{build.version} → 외부 그룹 '#{group.name}'"

    # 7) 공개 링크는 명시했을 때만 켠다
    if ENV["ENABLE_PUBLIC_LINK"] == "1"
      Spaceship::ConnectAPI.patch_group(group_id: group.id, attributes: { publicLinkEnabled: true, publicLinkLimitEnabled: false })
      UI.success "공개 링크 켬"
    end
  end

  desc "ASC 계정의 앱 목록(이름 · 번들 ID) 출력"
  lane :list_apps do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    Spaceship::ConnectAPI::App.all.each { |a| UI.message "#{a.name} · #{a.bundle_id}" }
  end

  desc "TestFlight 업로드. build_number를 ASC 최신+1로 자동 bump"
  lane :beta do
    api_key = asc_api_key
    next_build = latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, initial_build_number: 0) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: next_build)
    UI.success "📦 새 빌드 번호: #{next_build}"

    # Xcode에 Apple ID 로그인이 없어도 되게: API 키로 App Store 프로파일을 만들고(로컬 Apple Distribution 인증서와 짝) 수동 서명으로 내보낸다.
    # (API 키 권한으로는 Xcode 클라우드 관리 서명이 안 된다 — "Cloud signing permission error")
    # Game Center를 쓰면 앱 ID에 그 기능이 있어야 하고, 프로파일도 그 뒤에 만든 것이어야 한다.
    needs_gc = File.read(ENTITLEMENTS).include?("com.apple.developer.game-center")
    ensure_game_center(api_key) if needs_gc
    profile = { api_key: api_key, app_identifier: BUNDLE_ID, output_path: "build", filename: "Ccutu_AppStore.mobileprovision" }
    get_provisioning_profile(**profile)
    if needs_gc && !profile_has_entitlement?(lane_context[SharedValues::SIGH_PROFILE_PATH], "com.apple.developer.game-center")
      UI.important "프로파일에 Game Center 권한이 없어 새로 만든다"
      get_provisioning_profile(**profile, force: true)
    end
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # 아카이브도 이 App Store 프로파일로 직접 서명한다. 자동 서명은 Xcode 계정이 없어 공용(와일드카드)
    # 개발 프로파일을 고르는데, 거기엔 Game Center 권한이 없어 아카이브가 실패한다.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: TEAM_ID,
      targets: [SCHEME],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      scheme: SCHEME,
      project: PROJECT,
      export_method: "app-store",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["TF_CHANGELOG"] || "내부 테스트 빌드"
    )
    # Ccutu.xcodeproj는 git에 없으므로(xcodegen 생성물) 빌드 번호 커밋은 하지 않는다. 번호는 ASC 최신+1로 매번 결정.
  end

  desc "스크린샷 자동 캡처 (fastlane snapshot OS truncate 버그 우회 — UDID 직접)"
  desc "CcutuSnapshots UI 테스트 타깃이 있어야 한다 (App Store 제출 준비 때 추가)."
  lane :snapshot_all do
    require "fileutils"

    cache_dir = File.expand_path("~/Library/Caches/tools.fastlane")
    FileUtils.mkdir_p("#{cache_dir}/screenshots")

    File.write("#{cache_dir}/language.txt", LOCALE)
    File.write("#{cache_dir}/locale.txt", LOCALE.sub("-", "_"))
    File.write("#{cache_dir}/snapshot-launch_arguments.txt", "")

    Dir.glob("#{cache_dir}/screenshots/*").each { |f| File.delete(f) if File.file?(f) }
    sh("cd .. && rm -rf fastlane/screenshots/#{LOCALE}")

    UDIDS.each do |name, udid|
      UI.header "📸 #{name} (#{udid})"

      sh("xcrun simctl boot #{udid} 2>&1 || true")
      sh("xcrun simctl uninstall #{udid} #{BUNDLE_ID} 2>&1 || true")

      derived = "build/snapshot_derived_#{udid}"
      sh("cd .. && rm -rf #{derived}")

      sh("cd .. && xcodebuild test " \
         "-scheme #{SCHEME} " \
         "-project #{PROJECT} " \
         "-destination 'platform=iOS Simulator,id=#{udid}' " \
         "-derivedDataPath #{derived} " \
         "FASTLANE_SNAPSHOT=YES " \
         "FASTLANE_LANGUAGE=#{LOCALE} " \
         "-only-testing:#{UI_TEST_TARGET}/#{UI_TEST_TARGET}UITests/testTakeScreenshots " \
         "2>&1 | tail -30")

      target_dir = "../fastlane/screenshots/#{LOCALE}/#{name}"
      FileUtils.mkdir_p(target_dir)

      png_files = Dir.glob("#{cache_dir}/screenshots/*.png")
      if png_files.empty?
        UI.error "❌ #{name}: 캡처 PNG 없음 — UI Test 실행 또는 SnapshotHelper 동작 확인 필요"
      else
        png_files.each do |src|
          basename = File.basename(src)
          short_name = basename.sub(/^.+?-/, "")
          dest = File.join(target_dir, short_name)
          FileUtils.mv(src, dest)
          UI.message "  → #{short_name}"
        end
        UI.success "✅ #{name}: #{png_files.size}장 캡처"
      end
    end

    UI.header "✅ 모든 디바이스 캡처 완료"
  end

  desc "ASC 메타데이터 + 빌드 promote (submit X — 사용자 ASC web에서 manual submit)"
  lane :release_metadata do
    api_key = asc_api_key

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID).to_s,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: "fastlane/metadata",
      precheck_include_in_app_purchases: false
    )

    UI.success "✅ Metadata 업로드 완료. ASC web에서 검토 후 'Submit for Review' 진행."
  end

  desc "스크린샷 ASC 직접 업로드 (Spaceship::ConnectAPI — fastlane deliver silent skip 우회)"
  lane :upload_screenshots_direct do
    require 'spaceship'

    api_key = asc_api_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("App not found") unless app

    platform = Spaceship::ConnectAPI::Platform::IOS
    version = app.get_edit_app_store_version(platform: platform)
    UI.user_error!("No editable version (PREPARE_FOR_SUBMISSION 등이어야)") unless version
    UI.message "Version: #{version.version_string} (state: #{version.app_store_state})"

    localizations = version.get_app_store_version_localizations
    loc = localizations.find { |l| l.locale == LOCALE }
    UI.user_error!("#{LOCALE} localization not found") unless loc

    device_map = {
      "iPhone 17 Pro"     => "APP_IPHONE_61",   # 6.3" 1206×2622
      "iPhone 17 Pro Max" => "APP_IPHONE_67",   # 6.9" 1320×2868
    }

    device_map.each do |device_name, display_type|
      UI.header "📱 #{device_name} → #{display_type}"

      pngs = Dir.glob(File.join(File.dirname(__FILE__), "..", "fastlane", "screenshots", LOCALE, device_name, "*.png")).sort
      UI.message "PNG count: #{pngs.size}"
      next if pngs.empty?

      existing_sets = loc.get_app_screenshot_sets(includes: "appScreenshots")
      set = existing_sets.find { |s| s.screenshot_display_type == display_type }

      if set
        UI.message "Found existing set #{set.id} (#{(set.app_screenshots || []).size} screenshots) — deleting..."
        (set.app_screenshots || []).each(&:delete!)
      else
        UI.message "Creating new screenshot set for #{display_type}..."
        set = loc.create_app_screenshot_set(attributes: { screenshotDisplayType: display_type })
      end

      pngs.each do |path|
        basename = File.basename(path)
        UI.message "Uploading: #{basename}"
        begin
          set.upload_screenshot(path: path, wait_for_processing: false)
          UI.success "  ✅ #{basename}"
        rescue => error
          UI.error "  ❌ #{basename}: #{error.message}"
        end
      end
    end

    UI.header "🎉 Screenshot 업로드 완료"
  end

  desc "심사 자동 제출 + 자동 release (v1.1+ 권장). 첫 release는 release_metadata + ASC web manual."
  lane :release do
    api_key = asc_api_key

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID).to_s,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      force: true,
      skip_binary_upload: true,
